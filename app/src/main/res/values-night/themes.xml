<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Für den Darkmode übernehmen wir aktuell das gleiche Layout -->
    <style name="Base.Theme.InPhase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/forest_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pastel_green</item>
        <item name="colorOnPrimaryContainer">@color/forest_green_dark</item>
        <item name="colorSecondary">@color/pastel_green_light</item>
        <item name="colorOnSecondary">@color/text_dark</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorError">@color/error_color</item>
        <item name="colorOnError">@color/white</item>
    </style>
</resources>
