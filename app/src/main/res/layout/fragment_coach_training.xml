<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="130dp">

            <!-- HEADER BAR WITH TOP + BUTTON -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trainingsplanung"
                        android:textColor="@color/text_dark"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/calendar_coach_subtitle"
                        android:textColor="@color/text_light_gray"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Circular Top Add Button -->
                <ImageButton
                    android:id="@+id/btnTopAddTraining"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_gray"
                    android:backgroundTint="@color/forest_green"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white" />

            </LinearLayout>

            <!-- FEATURED MONTH CALENDAR CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/pastel_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Month Header Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <ImageButton
                            android:id="@+id/btnPrevMonthCoach"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_gray"
                            android:backgroundTint="@color/pastel_green_light"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_back_circle" />

                        <TextView
                            android:id="@+id/tvMonthTitleCoach"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="@color/text_dark"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="März 2026" />

                        <ImageButton
                            android:id="@+id/btnNextMonthCoach"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_gray"
                            android:backgroundTint="@color/pastel_green_light"
                            android:contentDescription="@null"
                            android:rotation="180"
                            android:src="@drawable/ic_back_circle" />
                    </LinearLayout>

                    <!-- Weekday Headers Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            tools:text="M"
                            android:textColor="@color/text_light_gray"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            tools:text="D"
                            android:textColor="@color/text_light_gray"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            tools:text="M"
                            android:textColor="@color/text_light_gray"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            tools:text="D"
                            android:textColor="@color/text_light_gray"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            tools:text="F"
                            android:textColor="@color/text_light_gray"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            tools:text="S"
                            android:textColor="@color/text_light_gray"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            tools:text="S"
                            android:textColor="@color/text_light_gray"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Month Grid RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMonthGridCoach"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="7" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DAILY SCHEDULE LIST SECTION -->
            <TextView
                android:id="@+id/tvSelectedDateLabelCoach"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Geplante Einheiten (25. Mär)" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTrainings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Empty State Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalendarEmptyCoach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/pastel_green_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="@string/calendar_no_sessions"
                    android:textAlignment="center"
                    android:textColor="@color/text_light_gray"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FLOATING ACTION BUTTON FOR ADDING TRAININGS -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTraining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="90dp"
        android:contentDescription="@null"
        app:backgroundTint="@color/forest_green"
        app:elevation="8dp"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/white"
        app:useCompatPadding="true" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>