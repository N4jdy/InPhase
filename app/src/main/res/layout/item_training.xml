<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/pastel_green"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Type Icon Badge -->
        <FrameLayout
            android:id="@+id/frameTypeIconBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_gray"
            android:backgroundTint="@color/type_team_training_bg">

            <ImageView
                android:id="@+id/imgTypeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_runner"
                app:tint="@color/type_team_training" />
        </FrameLayout>

        <!-- Session Title & Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTrainingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Team Training" />

            <TextView
                android:id="@+id/tvTrainingType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_light_gray"
                android:textSize="13sp"
                tools:text="Hauptplatz • Taktik" />
        </LinearLayout>

        <!-- Subtle Pastel Green Pill Time Badge -->
        <TextView
            android:id="@+id/tvTrainingTimeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_time_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/forest_green_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="18:00 Uhr" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>