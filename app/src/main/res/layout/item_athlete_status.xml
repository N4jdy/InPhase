<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/pastel_green"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Avatar Badge with Bottom-Right Status Dot -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|start"
                android:background="@drawable/circle_gray"
                android:backgroundTint="@color/mint_soft_bg">

                <TextView
                    android:id="@+id/tvAthleteInitials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/forest_green_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="LG" />
            </FrameLayout>

            <!-- Status Dot (Bottom-Right of Avatar) -->
            <View
                android:id="@+id/imgStatusDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/dot_colored"
                android:backgroundTint="@color/type_team_training" />
        </FrameLayout>

        <!-- Athlete Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAthleteName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Leon Goretzka" />

            <TextView
                android:id="@+id/tvAthleteStatusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_light_gray"
                android:textSize="13sp"
                tools:text="Zentrales Mittelfeld" />

            <!-- Optional Warning Tag -->
            <TextView
                android:id="@+id/tvWarningBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_warning_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/warning_high_fatigue"
                android:textColor="#B78103"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Score Pill & Subtext -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReadinessScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_score_pill_green"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/forest_green_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="94%" />

            <TextView
                android:id="@+id/tvSleepSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_light_gray"
                android:textSize="11sp"
                tools:text="Schlaf: 8.2h" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>